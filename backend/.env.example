# =========================================================================
# The Midnight Steeper - Environment Configuration Template
# All sensitive variables and endpoints should be placed in your private .env
# =========================================================================

# Embedded Local Database Path (SQLite)
SQLITE_DB_PATH=midnight_steeper.db

# Temporal Server Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=MIDNIGHT_STEEPER_TASK_QUEUE

# Brew duration in seconds (15 for rapid dev testing, 86400 for 24-hour real timer)
BREW_DURATION_SECONDS=15

# Local / Remote Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2

# Cloud LLM Configuration (Optional: Gemini, OpenAI, Groq)
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ONLINE_LLM_MODEL=gpt-4o-mini

# Speech Audio Configuration (Optional: ElevenLabs or Free Neural TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_API_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
FREE_TTS_ENDPOINT=https://translate.google.com/translate_tts
