# =========================================================================
# The Midnight Steeper - Environment Configuration Template
# No API keys are needed anywhere in this project.
# =========================================================================

# Embedded Local Database Path (SQLite)
SQLITE_DB_PATH=midnight_steeper.db

# Temporal Server Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=MIDNIGHT_STEEPER_TASK_QUEUE

# Brew duration in seconds when the client does not pick a steep length
BREW_DURATION_SECONDS=15

# Open-weight Gemma via Ollama. If Ollama is unreachable (e.g. Render free tier),
# the built-in lore writer is used automatically.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2

# Set to 0 to skip TabPFN even when it is installed (rule-based rarity model is used instead)
ENABLE_TABPFN=1
